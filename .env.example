# ============================================================
# SoFin — environment
# Copy to .env and fill in from Supabase Dashboard → Project Settings → API
# ============================================================

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# The "anon public" key. This one is MEANT to ship to the browser — row-level
# security in supabase/schema.sql is what protects the data.
SUPABASE_ANON_KEY=

# Never put the service_role key here. It bypasses RLS and this file's values
# end up in a public JS bundle.
