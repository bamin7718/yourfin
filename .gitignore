# ---- secrets & environment ----
.env
.env.*
!.env.example

# Generated at build time from the environment — never commit
public/js/env.js

# ---- tooling ----
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.vercel/
.supabase/

# ---- editors & OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- scratch ----
.tmp_*
*.local

# ---- Capacitor ----
# The native projects are generated from public/ by `npx cap add` in CI, so
# there is nothing here to keep in sync with the web app by hand.
/android/
/ios/
